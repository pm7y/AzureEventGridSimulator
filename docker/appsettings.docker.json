{
  "dashboardEnabled": true,
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Verbose"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ]
  },
  "topics": [
    {
      "name": "EventGridTopic",
      "port": 60101,
      "key": "TheLocal+DevelopmentKey=",
      "inputSchema": "EventGridSchema",
      "subscribers": {
        "http": [
          {
            "name": "RequestCatcherSubscription",
            "endpoint": "https://azureeventgridsimulator.requestcatcher.com/",
            "disableValidation": true
          }
        ],
        "serviceBus": [
          {
            "name": "ServiceBusQueueSubscription",
            "connectionString": "Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;",
            "queue": "eventgrid-events",
            "properties": {
              "EventType": {
                "type": "dynamic",
                "value": "EventType"
              },
              "Subject": {
                "type": "dynamic",
                "value": "Subject"
              },
              "Source": {
                "type": "static",
                "value": "AzureEventGridSimulator"
              }
            }
          },
          {
            "name": "ServiceBusTopicSubscription",
            "connectionString": "Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;",
            "topic": "eventgrid-topic",
            "properties": {
              "EventId": {
                "type": "dynamic",
                "value": "Id"
              }
            }
          }
        ],
        "storageQueue": [
          {
            "name": "StorageQueueSubscription",
            "connectionString": "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;QueueEndpoint=http://azurite:10001/devstoreaccount1;",
            "queueName": "eventgrid-events"
          }
        ],
        "eventHub": [
          {
            "name": "EventHubSubscription",
            "connectionString": "Endpoint=sb://eventhubs-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;",
            "eventHubName": "eventgrid-events",
            "properties": {
              "EventType": {
                "type": "dynamic",
                "value": "EventType"
              },
              "Source": {
                "type": "static",
                "value": "AzureEventGridSimulator"
              }
            }
          }
        ]
      }
    },
    {
      "name": "CloudEventsTopic",
      "port": 60102,
      "key": "TheLocal+DevelopmentKey=",
      "inputSchema": "CloudEventV1_0",
      "subscribers": {
        "http": [
          {
            "name": "CloudEventsRequestCatcherSubscription",
            "endpoint": "https://azureeventgridsimulator.requestcatcher.com/",
            "disableValidation": true
          }
        ]
      }
    }
  ]
}
