<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest</AnalysisLevel>
        <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!-- Analyzers applied to all projects -->
        <PackageReference Include="Meziantou.Analyzer">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <!--
        The AppHost references the simulator with AdditionalProperties="ASPIRE_ENABLED=true",
        so a full solution build compiles that project twice with different flavours. Give the
        Aspire flavour its own bin/obj, otherwise the two builds race on the same output paths
        (intermittent MSB4018 crashes) and can leave an Aspire-flavoured simulator binary in
        the shared bin that fails to start outside Aspire (missing ServiceDefaults.dll).
    -->
    <PropertyGroup Condition="'$(ASPIRE_ENABLED)' == 'true'">
        <BaseIntermediateOutputPath>obj/aspire/</BaseIntermediateOutputPath>
        <BaseOutputPath>bin/aspire/</BaseOutputPath>
        <!-- The regular flavour's bin/obj are no longer under this flavour's output paths,
             so exclude them from item globs explicitly. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    </PropertyGroup>

    <Target
        Name="CSharpier"
        BeforeTargets="BeforeBuild"
        Condition="'$(DesignTimeBuild)' != 'true' And '$(MSBuildProjectName)' == 'AzureEventGridSimulator' And '$(TargetFramework)' == 'net10.0' And '$(CI)' != 'true'"
    >
        <Exec
            Command="dotnet tool restore"
            WorkingDirectory="$(MSBuildThisFileDirectory).."
            StandardOutputImportance="low"
            StandardErrorImportance="low"
            ContinueOnError="true"
        />
        <Exec
            Command="dotnet tool run csharpier format src"
            WorkingDirectory="$(MSBuildThisFileDirectory).."
            StandardOutputImportance="low"
        />
    </Target>

    <Target
        Name="ConfigureGitHooks"
        BeforeTargets="BeforeBuild"
        Condition="'$(DesignTimeBuild)' != 'true' And '$(MSBuildProjectName)' == 'AzureEventGridSimulator' And '$(TargetFramework)' == 'net10.0' And Exists('$(MSBuildThisFileDirectory)../.git') And '$(CI)' != 'true'"
    >
        <Exec
            Command="git config core.hooksPath .githooks"
            WorkingDirectory="$(MSBuildThisFileDirectory).."
            StandardOutputImportance="low"
            StandardErrorImportance="low"
            ContinueOnError="true"
        />
    </Target>
</Project>
