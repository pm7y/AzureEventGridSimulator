{
  "topics": [
    {
      "name": "ATopicWithATestSubscriber",
      "port": 60101,
      "key": "TheLocal+DevelopmentKey=",
      "subscribers": {
        "http": [
          {
            "name": "RequestCatcherSubscription",
            "endpoint": "https://azureeventgridsimulator.requestcatcher.com",
            "disableValidation": true,
            "disabled": true
          }
        ],
        "eventHub": [
          {
            "name": "EventHubSubscription",
            "connectionString": "Endpoint=sb://my-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=abc123",
            "eventHubName": "my-event-hub",
            "disabled": true
          }
        ]
      }
    }
  ],
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "aegs_test_log_.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 1
        }
      }
    ]
  }
}