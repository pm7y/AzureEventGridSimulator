<!-- Keep the Sdk version in lockstep with the Aspire.Hosting.* versions in Directory.Packages.props -->
<Project Sdk="Aspire.AppHost.Sdk/13.5.3">
    <PropertyGroup>
        <!-- TargetFramework, ImplicitUsings and Nullable are inherited from Directory.Build.props -->
        <OutputType>Exe</OutputType>
        <IsAspireHost>true</IsAspireHost>
        <UserSecretsId>568b81ee-880c-4743-beb4-ca331e309492</UserSecretsId>
        <!-- Keep DCP and the Aspire Dashboard coming from NuGet, so `dotnet run` works without the
             Aspire CLI installed. Aspire 13.5+ warns about this (ASPIRE010); the suppression is
             what https://aka.ms/aspire/diagnostics/aspire010 recommends for this choice. -->
        <AspireUseCliBundle>false</AspireUseCliBundle>
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.Azure.Storage" />
        <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
        <PackageReference Include="Aspire.Hosting.Azure.EventHubs" />
        <PackageReference Include="Aspire.Hosting.SqlServer" />
    </ItemGroup>

    <!-- Set ASPIRE_ENABLED=true to include ServiceDefaults in the build -->
    <PropertyGroup>
        <ASPIRE_ENABLED>true</ASPIRE_ENABLED>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference
            Include="..\AzureEventGridSimulator\AzureEventGridSimulator.csproj"
            SetTargetFramework="TargetFramework=net10.0"
            AdditionalProperties="ASPIRE_ENABLED=true"
        />
    </ItemGroup>

    <!--
        The simulator is built with ASPIRE_ENABLED=true into its own bin/aspire and obj/aspire
        output paths (see Directory.Build.props), and solution-level restore never sees that
        flavour, so restore it explicitly before this project resolves its references.
    -->
    <Target Name="RestoreAspireFlavouredSimulator" BeforeTargets="ResolveProjectReferences">
        <MSBuild
            Projects="..\AzureEventGridSimulator\AzureEventGridSimulator.csproj"
            Targets="Restore"
            Properties="ASPIRE_ENABLED=true"
        />
    </Target>
</Project>
