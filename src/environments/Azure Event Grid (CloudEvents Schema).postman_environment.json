{
  "id": "azure-cloudevents",
  "name": "Azure Event Grid (CloudEvents Schema)",
  "values": [
    {
      "key": "baseUrl",
      "value": "https://YOUR-CLOUDEVENTS-TOPIC.YOUR-REGION.eventgrid.azure.net",
      "type": "default",
      "enabled": true
    },
    {
      "key": "sasKey",
      "value": "YOUR-CLOUDEVENTS-TOPIC-KEY",
      "type": "secret",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}
